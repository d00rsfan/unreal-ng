# The native DEB deliberately builds against Ubuntu's Qt and shared libraries.
FROM ubuntu:26.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates git cmake ninja-build gcc-14 g++-14 make python3 \
    pkg-config dpkg-dev file binutils \
    qt6-base-dev qt6-5compat-dev qt6-multimedia-dev qt6-svg-dev \
    libgl-dev libssl-dev zlib1g-dev libzstd-dev liblzma-dev \
    libjsoncpp-dev liblua5.4-dev uuid-dev \
    && rm -rf /var/lib/apt/lists/*
ENV CC=gcc-14 CXX=g++-14
